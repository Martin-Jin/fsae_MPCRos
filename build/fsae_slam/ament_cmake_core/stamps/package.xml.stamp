<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_slam</name>
  <version>0.1.0</version>
  <description>Cone landmark SLAM - fuses camera and lidar detections into a persistent track map</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>fsae_interfaces</depend>
  <depend>python3-numpy</depend>
  <!-- Working Python node (scripts/cone_mapper.py) needs the `kdtree` pip package
       (not in rosdep): pip install kdtree -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
