<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_camera</name>
  <version>0.1.0</version>
  <description>ZED camera perception (YOLO cone detection). Subscribes to zed_ros2_wrapper topics - no ZED SDK link. Still needs CUDA + TensorRT, so Jetson-only to build.</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_cmake_auto</build_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>fsae_interfaces</depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>zed_wrapper</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
