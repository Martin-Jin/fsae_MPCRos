<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_lidar</name>
  <version>0.1.0</version>
  <description>Camera-LiDAR fusion: refines camera cone detections against the Velodyne LiDAR.</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>fsae_interfaces</depend>
  <depend>python3-numpy</depend>
  <exec_depend>python3-sensor-msgs-py</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- Velodyne driver is NOT vendored; install from apt:
       sudo apt install ros-$ROS_DISTRO-velodyne  (provides the runtime nodes
       used by launch/velodyne_vlp16.launch.py). Declared so rosdep can fetch it. -->
  <exec_depend>velodyne</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>builtin_interfaces</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
