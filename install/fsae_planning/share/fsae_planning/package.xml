<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_planning</name>
  <version>0.1.0</version>
  <description>Path planning: fasttube, fasttube_without_kalman, and centerline planners</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>fsae_interfaces</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <depend>python3-numpy</depend>
  <depend>python3-matplotlib</depend>
  <depend>python3-scipy</depend>
  <depend>python3-shapely</depend>
  <!-- fasttube planners need the fsd_path_planning pip package (not in rosdep):
       pip install fsd-path-planning -->


  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
