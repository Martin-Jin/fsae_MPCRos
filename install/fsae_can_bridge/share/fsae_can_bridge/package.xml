<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_can_bridge</name>
  <version>0.1.0</version>
  <description>CAN bus bridge - merges gocart_control, gocart_driver and CanTalk (ack-to-CAN, CAN decode, status)</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <depend>fsae_interfaces</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rcl_interfaces</depend>
  <depend>message_filters</depend>
  <depend>python3-numpy</depend>
  <exec_depend>python3-serial</exec_depend>   <!-- pyserial: CANdapter USB-serial bridge (candapter_node) -->
  <!-- Pip-only deps (not in rosdep), needed at runtime on the Jetson:
       - spidev          : MCP2515 SPI driver (drivers/MCP2515.py)
       - pyPS4Controller : joystick_teleop -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
