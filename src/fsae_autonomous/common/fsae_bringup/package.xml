<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch composition and central YAML configuration for the FSAE autonomous system</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <exec_depend>ros2launch</exec_depend>

  <!-- Subsystem packages composed by the bringup launch files (Stage 3) -->
  <exec_depend>fsae_mission_control</exec_depend>
  <exec_depend>fsae_planning</exec_depend>
  <exec_depend>fsae_control</exec_depend>
  <exec_depend>fsae_can_bridge</exec_depend>
  <exec_depend>fsae_slam</exec_depend>
  <exec_depend>fsae_camera</exec_depend>
  <exec_depend>fsae_lidar</exec_depend>
  <exec_depend>fsae_visualization</exec_depend>
  <exec_depend>fsae_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
