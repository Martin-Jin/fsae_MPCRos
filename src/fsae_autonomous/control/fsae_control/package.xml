<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fsae_control</name>
  <version>0.1.0</version>
  <description>Lateral/longitudinal control (Stanley controller)</description>
  <maintainer email="fsae@auckland.ac.nz">UoA FSAE</maintainer>
  <license>MIT</license>

  <depend>ackermann_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>fsae_interfaces</depend>
  <!-- nav_msgs: the NMPC controller's /fsae/slam/car_odom subscription (GAP
       A1/A2/A3 placeholder). The Stanley controller (default) has no such
       dependency. -->
  <depend>nav_msgs</depend>

  <depend>python3-numpy</depend>
  <depend>python3-matplotlib</depend>
  <!-- Needed by the NMPC controller (mpc/nmpc_core.py) only: scipy.sparse and
       scipy.interpolate.CubicSpline for the path reference and QP condensing.
       The Stanley controller (default) has no such dependency. -->
  <depend>python3-scipy</depend>

  <!-- The NMPC controller (mpc/nmpc_core.py) additionally needs osqp. This is
       pip-only (no rosdep key), see requirements.txt. Install once into the
       ROS interpreter: pip install osqp (Ubuntu 24.04: add the
       break-system-packages flag). The Stanley controller (default) has no
       such dependency; this repo does not carry the LTV-QP controller
       (mpc_core.py) or its cvxpy/clarabel dependency at all. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
